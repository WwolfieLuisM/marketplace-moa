# ===== Marketplace Moa — variables de entorno de referencia =====
# Copia a backend/.env con valores reales. Nunca commits el .env.
# Los valores reales de cada var se cargan también en Render / GitHub Secrets /
# Cloudflare Pages según corresponda.

# NEON (Postgres) — connection string del branch production (pooled recommended)
DATABASE_URL=postgresql://USER:PASSWORD@ep-POOLER.c-rw.us-east-2.aws.neon.tech/neondb?sslmode=require

# Job diario de suscripciones (se envía como header X-Job-Key)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_SECRET_KEY=<hex de 64 caracteres>

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Firebase Admin (valores del service account JSON descargado)
FIREBASE_PROJECT_ID=<project-id>
FIREBASE_CLIENT_EMAIL=<client-email>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<clave privada>\n-----END PRIVATE KEY-----\n"

# Frontend (NEXT_PUBLIC_* -> se definen en Cloudflare Pages, no en .env local)
NEXT_PUBLIC_API_URL=https://<backend>.onrender.com