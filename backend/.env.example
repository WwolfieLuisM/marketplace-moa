# Marketplace Moa — backend. Copia este archivo a .env y rellena los valores.
# NUNCA comitees .env (ya está en .gitignore).

# PostgreSQL (Neon). DATABASE_URL con pooler (Prisma), DIRECT_URL sin pooler
# (lo exige Prisma para migraciones en Neon).
DATABASE_URL="postgresql://usuario:password@<host-pooler>/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:password@<host>/neondb?sslmode=require"

# Firmas JWT (cualquier cadena larga y aleatoria).
JWT_SECRET="cambiamelo"
REFRESH_TOKEN_SECRET="cambiamelo-tambien"

# Clave del job de mantenimiento (el cron de GitHub la manda en X-Job-Key).
JOB_SECRET_KEY="cambiamela"

# Google OAuth (consola de Google Cloud).
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"

# Gmail SMTP para correos de recuperación (App Password de Google).
GMAIL_SMTP_USER="tu-correo@gmail.com"
GMAIL_SMTP_PASS="tu-app-password"

# Cloudinary (fotos de productos).
CLOUDINARY_CLOUD_NAME="tu-cloud"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="abc123"

# Origen(es) permitidos por CORS, separados por coma.
FRONTEND_URL="https://tu-sitio.example.com"
# URL base para los enlaces de recuperación que llegan por correo.
FRONTEND_BASE_URL="https://tu-sitio.example.com"

# Cookies de refresh: seguro y sameSite para producción.
NODE_ENV="development"
# COOKIE_SECURE="true"
# COOKIE_SAME_SITE="none"  # 'lax' en desarrollo local

# Puerto del servidor.
PORT=3001